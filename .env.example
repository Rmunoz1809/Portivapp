# Portiv — variables de entorno. Copia a `.env` y rellena. `.env` NO se versiona.
# Ningún valor real debe acabar commiteado ni hardcodeado en index.html.

# ─── Paddle: claves de API (servidor / MCP) ──────────────────────────────────
# vendors.paddle.com → Developer tools → Authentication → API keys.
# Secretas. Las leen los servidores MCP `paddle-live` y `paddle-sandbox`
# (~/.claude/plugins/cache/claude-community/paddle/*/.mcp.json) y cualquier
# llamada server-side a api.paddle.com.
PADDLE_LIVE_API_KEY=
PADDLE_SANDBOX_API_KEY=

# ─── Paddle: token client-side (navegador) ───────────────────────────────────
# Developer tools → Authentication → Client-side tokens. Empieza por `live_`
# (o `test_` en sandbox). Es público por diseño —viaja al navegador— pero se
# inyecta en el build para no fijar el entorno en el fuente.
# Sustituye el placeholder `PADDLE_LIVE_CLIENT_TOKEN` de index.html.
PADDLE_CLIENT_TOKEN=

# ─── Paddle: catálogo (price IDs que abre el checkout web) ───────────────────
# Deben ser los IDs de la cuenta LIVE. Ver window.PADDLE_PRICES en index.html.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_ANNUAL=

# ─── Paddle: webhook (Supabase Edge Function `paddle-webhook`) ───────────────
# Developer tools → Notifications → destino → `endpoint_secret_key` (`pdl_ntfset_…`).
# Sólo se muestra al crear el destino: si se pierde, hay que rotarlo.
# En producción NO va en .env, va en los secretos de Supabase:
#   supabase secrets set PADDLE_WEBHOOK_SECRET=...
PADDLE_WEBHOOK_SECRET=

# `production` | `sandbox`. Sella la columna `environment` cuando Paddle no manda
# el header `Paddle-Environment`, y decide si la allowlist de IPs incluye sandbox.
PADDLE_ENV=production

# Allowlist de IPs de Paddle. La lista se descarga de https://api.paddle.com/ips
# (nunca se hardcodea). Con `true`, si ese endpoint no responde se rechaza el
# evento; por defecto (`false`) se continúa con la verificación de firma HMAC.
PADDLE_IP_ALLOWLIST_STRICT=false
