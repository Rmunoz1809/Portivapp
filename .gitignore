.anthropic_key
config.local.js
# Valores reales de las variables de entorno (Paddle, etc.). La plantilla
# versionada es .env.example; .env NUNCA se sube.
.env
.env.local
.DS_Store
supabase/.temp/

# Local Netlify folder
.netlify

# Paso de build (A6): dependencias y artefacto generado — no se versionan.
# El fuente es index.html; dist/index.html se regenera con `npm run build`.
node_modules/
dist/
package-lock.json

# Estado local de Claude Code (logs de sesión) — no es del proyecto.
.claude/

# Copias de seguridad locales del bundle web — no se versionan.
portiv-cap/_backups/

# Caché de la calibración de anclas: 700+ respuestas de Finnhub, se regenera sola.
.cache-anclas/
